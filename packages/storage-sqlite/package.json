{
  "name": "@detuned/storage-sqlite",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/generate-schema.mjs",
    "generate:schema": "node scripts/generate-schema.mjs",
    "check:schema": "node scripts/check-schema-sync.mjs",
    "build": "node scripts/generate-schema.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-schema-sync.mjs && tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@detuned/core": "workspace:*",
    "@detuned/protocol": "workspace:*",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "typescript": "^5.8.2"
  }
}
