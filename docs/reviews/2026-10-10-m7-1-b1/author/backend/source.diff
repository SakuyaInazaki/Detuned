+/** RFC 8785 serialization for already-parsed JSON values. No text parser or Proxy isolation. */
+export type ReviewCanonicalizationReason = 'invalid_json' | 'max_bytes' | 'max_depth' | 'max_nodes';
+export class ReviewCanonicalizationError extends Error {
+  constructor(readonly reason: ReviewCanonicalizationReason) {
+    super('Review canonical JSON is invalid or exceeds its fixed limits.');
+    this.name = 'ReviewCanonicalizationError';
+  }
+}
+const MAX_BYTES = 262144;
+const MAX_DEPTH = 64;
+const MAX_NODES = 20000;
+const encoder = new TextEncoder();
+
+export function canonicalizeReviewJson(value: unknown): string {
+  const parts: string[] = [];
+  const ancestors = new Set<object>();
+  let bytes = 0;
+  let nodes = 0;
+  const fail = (reason: ReviewCanonicalizationReason): never => { throw new ReviewCanonicalizationError(reason); };
+  const emit = (text: string) => {
+    bytes += encoder.encode(text).byteLength;
+    if (bytes > MAX_BYTES) fail('max_bytes');
+    parts.push(text);
+  };
+  const string = (text: string): string => {
+    // UTF-16 code units alone already exceed the UTF-8/output bound in this case.
+    if (text.length > MAX_BYTES) fail('max_bytes');
+    for (let i = 0; i < text.length; i++) {
+      const unit = text.charCodeAt(i);
+      if (unit >= 0xd800 && unit <= 0xdbff) {
+        const next = text.charCodeAt(++i);
+        if (!(next >= 0xdc00 && next <= 0xdfff)) fail('invalid_json');
+      } else if (unit >= 0xdc00 && unit <= 0xdfff) fail('invalid_json');
+    }
+    return JSON.stringify(text);
+  };
+  const dataDescriptor = (object: object, key: string): PropertyDescriptor => {
+    const descriptor = Object.getOwnPropertyDescriptor(object, key);
+    if (!descriptor) return fail('invalid_json');
+    if (!descriptor.enumerable || !Object.prototype.hasOwnProperty.call(descriptor, 'value')) fail('invalid_json');
+    return descriptor;
+  };
+  const visit = (item: unknown, depth: number): void => {
+    if (depth > MAX_DEPTH) fail('max_depth');
+    if (++nodes > MAX_NODES) fail('max_nodes');
+    if (item === null) { emit('null'); return; }
+    switch (typeof item) {
+      case 'boolean': emit(item ? 'true' : 'false'); return;
+      case 'number':
+        if (!Number.isFinite(item)) fail('invalid_json');
+        emit(JSON.stringify(item)); return;
+      case 'string': emit(string(item)); return;
+      case 'object': break;
+      default: fail('invalid_json');
+    }
