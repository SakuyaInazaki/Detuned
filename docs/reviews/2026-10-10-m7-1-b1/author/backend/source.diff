+      const keys = Object.getOwnPropertyNames(object);
+      if (array) {
+        const lengthDescriptor = Object.getOwnPropertyDescriptor(object, 'length');
+        if (!lengthDescriptor) return fail('invalid_json');
+        if (!Object.prototype.hasOwnProperty.call(lengthDescriptor, 'value')) fail('invalid_json');
+        const length: number = lengthDescriptor.value;
+        if (length > MAX_NODES - nodes) fail('max_nodes');
+        if (keys.length !== length + 1) fail('invalid_json');
