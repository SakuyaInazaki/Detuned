(version 1)
(allow default)
(deny network*)
(allow network-outbound (remote ip "localhost:50704"))
(deny mach-lookup)
(deny file-read* file-write* (subpath "/Users/sakimi/.codex") (subpath "/Users/sakimi/.claude") (literal "/Users/sakimi/.claude.json") (subpath "/Users/sakimi/.config") (subpath "/Users/sakimi/Library/Keychains") (subpath "/Library/Keychains") (subpath "/Users/sakimi/Library/Application Support/Codex") (subpath "/Users/sakimi/Library/Application Support/Claude") (literal "/private/tmp/detuned-claude-control-DUxQQs/forbidden-sentinel"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/detuned-claude-control-DUxQQs"))
(deny file-read* file-write* (literal "/private/tmp/detuned-claude-control-DUxQQs/forbidden-sentinel"))
