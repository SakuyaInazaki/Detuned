+
+export type FixedRules = { spaceId: string; revision: number; offset: number; cursor: string | null; chunks: string[];
+  accumulatedBytes: number; rawMode: boolean; currentChunk: string; complete: boolean;
+  document?: { objective: string; rules: string[] } };
+export function initialRules(spaceId: string, revision: number): FixedRules {
+  return { spaceId, revision, offset: 0, cursor: null, chunks: [], accumulatedBytes: 0, rawMode: false, currentChunk: '', complete: false };
+}
+export function appendRules(previous: FixedRules, page: import('@detuned/protocol').SpaceRevisionPage): FixedRules {
+  const { data, meta } = page;
+  if (!data || !meta || data.ref?.space_id !== previous.spaceId || data.ref.revision !== previous.revision || data.encoding !== 'json'
+    || typeof data.chunk !== 'string' || data.start_byte !== previous.offset || !Number.isSafeInteger(data.end_byte)
+    || data.end_byte <= data.start_byte || new TextEncoder().encode(data.chunk).byteLength !== data.end_byte - data.start_byte
+    || typeof data.complete !== 'boolean' || (data.complete ? meta.truncated !== false || meta.next_cursor !== null
+      : meta.truncated !== true || typeof meta.next_cursor !== 'string' || !meta.next_cursor)) throw new ClientProtocolError('Invalid fixed rules page.');
+  const bytes = new TextEncoder().encode(data.chunk).byteLength;
+  const rawMode = previous.rawMode || previous.accumulatedBytes + bytes > CONTENT_ACCUMULATION_LIMIT;
+  const chunks = rawMode ? [] : [...previous.chunks, data.chunk];
+  let document: FixedRules['document'];
+  if (data.complete && !rawMode) {
+    try {
+      const value: unknown = JSON.parse(chunks.join(''));
+      if (!record(value) || Object.keys(value).sort().join(',') !== 'objective,rules' || typeof value.objective !== 'string'
+        || !Array.isArray(value.rules) || !value.rules.every((rule: unknown) => typeof rule === 'string')) throw new Error('Invalid rules.');
+      document = { objective: value.objective, rules: value.rules };
+    } catch { throw new ClientProtocolError('Invalid fixed rules document.'); }
+  }
+  return { ...previous, offset: data.end_byte, cursor: meta.next_cursor, chunks, accumulatedBytes: rawMode ? 0 : previous.accumulatedBytes + bytes,
+    rawMode, currentChunk: data.chunk, complete: data.complete, ...(document ? { document } : {}) };
+}
