+/** Fresh actions only. Caller first applies current authentication and online material privacy. */
+export function assertReviewSnapshotCurrent(storage:StoragePort,records:{record:ReviewSnapshotRecord;manifest:ReviewSnapshotManifestData}):void {
+  const {record,manifest}=records,space=storage.findSpaceById(record.space_id);
+  const stale=()=>new DetunedError(ErrorCode.SNAPSHOT_STALE,'Review material is no longer current and available.',409);
+  if(!space||space.policy_revision!==record.policy_revision)throw stale();
+  for(const entry of [manifest.target,...manifest.dependencies]){
+    const post=storage.findPostById(entry.ref.post_id);
+    if(!post||post.lifecycle!=='active'||post.current_revision!==entry.ref.revision)throw stale();
+  }
+  for(const entry of manifest.artifacts)if(storage.findArtifactById(entry.artifact_id)?.state!=='ready')throw stale();
+}
