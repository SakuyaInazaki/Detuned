+import { createHash } from 'node:crypto';
+import { isDeepStrictEqual } from 'node:util';
+import { DetunedError, ErrorCode, isReviewSnapshotManifest, type ReviewSnapshotRecord,
+  type ReviewSnapshotItemRecord, type ReviewSnapshotManifestData, type ReviewRequestView } from '@detuned/protocol';
+import { type StoragePort } from '../ports/storage.js';
+const cmp=(a:string,b:string)=>a<b?-1:a>b?1:0;
+const goodHash=(v:unknown):v is string=>typeof v==='string'&&v.length===64&&/^[0-9a-f]+$/.test(v);
+const positive=(v:number)=>Number.isSafeInteger(v)&&v>0;
+const id=(v:unknown):v is string=>typeof v==='string'&&v.length>0;
+export const reviewResync=()=>new DetunedError(ErrorCode.RESYNC_REQUIRED,'Stored review material cannot be safely reconstructed.',409);
+const missing=()=>new DetunedError(ErrorCode.NOT_FOUND,'Review material does not exist or is not accessible.',404);
+const redacted=()=>new DetunedError(ErrorCode.CONTENT_REDACTED,'Review material has been redacted.',410);
+function postPrivacy(storage:StoragePort,spaceId:string,postId:string){
+  const post=storage.findPostById(postId);
+  if(!post||post.space_id!==spaceId)throw missing();
+  if(post.lifecycle==='redacted')throw redacted();
+}
+export function reviewSnapshotItems(snapshotId:string,manifest:ReviewSnapshotManifestData):ReviewSnapshotItemRecord[]{
+  return [
+    {snapshot_id:snapshotId,item_type:'target_post',item_id:manifest.target.ref.post_id,revision:manifest.target.ref.revision,sha256:manifest.target.content_hash},
+    ...manifest.dependencies.map(d=>({snapshot_id:snapshotId,item_type:'dependency_post' as const,item_id:d.ref.post_id,revision:d.ref.revision,sha256:d.content_hash})),
+    ...manifest.artifacts.map(a=>({snapshot_id:snapshotId,item_type:'artifact' as const,item_id:a.artifact_id,revision:0,sha256:a.sha256})),
+    {snapshot_id:snapshotId,item_type:'space_rules',item_id:manifest.space_id,revision:manifest.rules_revision,sha256:null},
+  ];
+}
+const itemKey=(i:ReviewSnapshotItemRecord)=>JSON.stringify([i.item_type,i.item_id,i.revision]);
+
+/** Only raw SHA/header/item/visibility checks here; JCS belongs exclusively to the review module. */
+export function readReviewSnapshotRecords(storage:StoragePort,spaceId:string,snapshotId:string):
+  {record:ReviewSnapshotRecord;manifest:ReviewSnapshotManifestData}{
+  const record=storage.findReviewSnapshotById(snapshotId);
+  if(!record||record.space_id!==spaceId)throw missing();
+  if(!record.target_ref||!id(record.target_ref.post_id))throw reviewResync();
+  postPrivacy(storage,spaceId,record.target_ref.post_id);
+  if(record.id!==snapshotId||!positive(record.target_ref.revision)||!positive(record.policy_revision)||!positive(record.rules_revision)||
+    !id(record.created_by)||!id(record.created_at)||typeof record.manifest_json!=='string'||Buffer.byteLength(record.manifest_json,'utf8')>262144||
+    !goodHash(record.manifest_sha256)||createHash('sha256').update(record.manifest_json,'utf8').digest('hex')!==record.manifest_sha256)throw reviewResync();
+  let manifest:ReviewSnapshotManifestData;
+  try{const value:unknown=JSON.parse(record.manifest_json);if(!isReviewSnapshotManifest(value))throw reviewResync();manifest=value;}
+  catch(error){if(error instanceof DetunedError)throw error;throw reviewResync();}
+  for(const ref of [manifest.target.ref,...manifest.dependencies.map(d=>d.ref)])postPrivacy(storage,spaceId,ref.post_id);
+  for(const entry of manifest.artifacts){const artifact=storage.findArtifactById(entry.artifact_id);
+    if(!artifact||artifact.space_id!==spaceId||artifact.visibility!=='space')throw missing();
+    if(artifact.state==='redacted')throw redacted();
+    if(artifact.sha256!==entry.sha256||artifact.bytes!==entry.bytes)throw reviewResync();
+  }
+  if(manifest.space_id!==spaceId||!isDeepStrictEqual(manifest.target.ref,record.target_ref)||manifest.rules_revision!==record.rules_revision||manifest.policy_revision!==record.policy_revision)throw reviewResync();
+  for(const entry of [manifest.target,...manifest.dependencies]){
+    const metadata=storage.getPostRevisionMetadata(entry.ref.post_id,entry.ref.revision);
+    if(!metadata||metadata.content_hash!==entry.content_hash)throw reviewResync();
+  }
+  let rules;try{rules=storage.getSpaceRevision(spaceId,manifest.rules_revision);}catch(error){if(error instanceof SyntaxError)throw reviewResync();throw error;}
+  if(!rules||!rules.review_policy||!Array.isArray(rules.review_policy.required_checks)||!rules.check_profiles||typeof rules.check_profiles!=='object')throw reviewResync();
+  const expected=reviewSnapshotItems(snapshotId,manifest),actual=storage.listReviewSnapshotItems(snapshotId);
+  if(new Set(expected.map(itemKey)).size!==expected.length||actual.length!==expected.length||
+    !isDeepStrictEqual([...expected].sort((a,b)=>cmp(itemKey(a),itemKey(b))),[...actual].sort((a,b)=>cmp(itemKey(a),itemKey(b)))))throw reviewResync();
+  // Set-like input fields have explicit canonical order; meaningful arrays remain untouched.
+  const checks=[...manifest.review_policy.required_checks].sort(cmp);
+  if(checks.some(n=>!id(n)||!/\S/.test(n))||checks.length>32||new Set(checks).size!==checks.length||
+    !isDeepStrictEqual(checks,manifest.review_policy.required_checks)||
+    !isDeepStrictEqual(manifest.check_profiles.map(p=>p.check_name),checks))throw reviewResync();
+  const normalizePolicy={...rules.review_policy,required_checks:[...rules.review_policy.required_checks].sort(cmp)};
+  if(!isDeepStrictEqual(normalizePolicy,manifest.review_policy))throw reviewResync();
+  for(const profile of manifest.check_profiles){const original=Object.hasOwn(rules.check_profiles,profile.check_name)?rules.check_profiles[profile.check_name]:undefined;
+    if(!original||!Array.isArray(original.verifier_actor_ids)||!isDeepStrictEqual(profile,{check_name:profile.check_name,config_sha256:original.config_sha256,
+      verifier_actor_ids:[...original.verifier_actor_ids].sort(cmp),description:original.description}))throw reviewResync();}
+  const ordered = <T>(items:T[],key:(item:T)=>string) => {
+    const keys=items.map(key);return new Set(keys).size===keys.length&&isDeepStrictEqual(keys,[...keys].sort(cmp));
+  };
+  const refs=manifest.dependencies.map(d=>JSON.stringify([d.ref.post_id,d.ref.revision]));
+  if(new Set(refs).size!==refs.length||manifest.dependencies.some(d=>isDeepStrictEqual(d.ref,manifest.target.ref))||
+    !isDeepStrictEqual(manifest.dependencies,[...manifest.dependencies].sort((a,b)=>cmp(a.ref.post_id,b.ref.post_id)||a.ref.revision-b.ref.revision))||
+    !ordered(manifest.artifacts,a=>a.artifact_id)||!ordered(manifest.contributors,a=>a)||
+    !isDeepStrictEqual(manifest.code_refs,[...manifest.code_refs].sort((a,b)=>cmp(a.repository,b.repository)||cmp(a.commit,b.commit)||cmp(a.source_artifact_id,b.source_artifact_id)))||
+    new Set(manifest.code_refs.map(c=>JSON.stringify([c.repository,c.commit,c.source_artifact_id]))).size!==manifest.code_refs.length||
+    manifest.code_refs.some(c=>!manifest.artifacts.some(a=>a.artifact_id===c.source_artifact_id)))throw reviewResync();
+  let nodes=0;const stack:{value:unknown;depth:number}[]=[{value:manifest,depth:0}];
+  while(stack.length){const item=stack.pop()!;if(++nodes>20000||item.depth>64)throw reviewResync();
+    if(item.value!==null&&typeof item.value==='object')for(const value of Object.values(item.value))stack.push({value,depth:item.depth+1});}
+  return {record,manifest};
+}
+
+export function reconstructReviewRequestView(storage:StoragePort,spaceId:string,requestId:string,version?:number):ReviewRequestView{
+  const head=storage.findReviewRequestById(requestId);
+  if(!head||head.space_id!==spaceId)throw missing();
+  if(!head.target_ref||!id(head.target_ref.post_id))throw reviewResync();
+  postPrivacy(storage,spaceId,head.target_ref.post_id);
+  if(head.id!==requestId||!positive(head.round)||!positive(head.version)||!id(head.requested_by)||!id(head.created_at))throw reviewResync();
+  const storedVersion=storage.findReviewRequestVersion(requestId,version??head.version);
+  const snapshot=readReviewSnapshotRecords(storage,spaceId,head.snapshot_id);
+  if(!storedVersion||storedVersion.request_id!==requestId||!positive(storedVersion.version)||storedVersion.version>(head.version)||
