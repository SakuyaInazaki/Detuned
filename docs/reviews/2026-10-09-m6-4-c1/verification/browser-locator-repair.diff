 test('CW01 ordinary requester and distinct reviewers explicitly select sessions, bind private evidence, seal/reveal and preserve historical decision',async({page,forum})=>{
  const setup=await forum.setupReview();page.on('dialog',dialog=>void dialog.accept());await page.goto(forum.baseURL);await login(page,forum,'requester');let panel=await enter(page,forum,setup.target);await create(panel,setup);await expect(panel.getByText(/评审请求已创建：/)).toBeVisible();await open(panel);await expect(panel.getByRole('region',{name:'固定评审材料'})).toContainText('Independent local claim');await logout(page);
